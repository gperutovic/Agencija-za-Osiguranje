rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isBrokerOrAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['broker', 'admin']
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isBrokerOrAdmin();
    }
    match /quotes/{quoteId} {
      allow create: if true; // Public prospects can submit quote inquiries
      allow read, update, delete: if isBrokerOrAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    match /policies/{policyId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isBrokerOrAdmin());
      allow write: if isBrokerOrAdmin();
    }
    match /claims/{claimId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isBrokerOrAdmin());
      allow update, delete: if isBrokerOrAdmin();
    }
    match /appointments/{appointmentId} {
      allow create: if true;
      allow read, update, delete: if isBrokerOrAdmin() || (isAuthenticated() && resource.data.customerEmail == request.auth.token.email);
    }
  }
}
