    function isValidClaimStageTransition(prevStage, nextStage) {
      return prevStage == nextStage ||
             (prevStage == 'received' && nextStage == 'insurer_review') ||
             (prevStage == 'insurer_review' && nextStage == 'assessment') ||
             (prevStage == 'assessment' && nextStage == 'paid');
