rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Accounts & Broker Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Comparative Quotes & Leads
    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    // Policies In-Force & Bound Contracts
    match /policies/{policyId} {
      allow read, write: if true;
    }

    // FNOL First Notice of Loss Claims
    match /claims/{claimId} {
      allow read, write: if true;
    }

    // Informative Offers (Synchronized between Korisnicki & Zastupnicki Portal)
    match /informative_offers/{offerId} {
      allow read, write: if true;
    }

    // Multi-Phase Contracting Pipeline
    match /contract_pipeline/{pipelineId} {
      allow read, write: if true;
    }

    // GDPR Data Export & Deletion Requests
    match /gdpr_requests/{requestId} {
      allow read, write: if true;
    }

    // Marketing Campaigns & Renewal Dispatches
    match /marketing_campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Policy Endorsement & Change Requests
    match /endorsements/{endorsementId} {
      allow read, write: if true;
    }

    // Certified Broker Consultations
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Digital Insurance Cards & ACORD 25 COIs
    match /digital_cards/{cardId} {
      allow read, write: if true;
    }

    // Contact Inquiries & Feedback
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // High-Converting Online Leads from Wizards
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // IDD Demands and Needs Assessments
    match /needs_assessments/{assessmentId} {
      allow read, write: if true;
    }

    // Official Complaints Register (čl. 401. / čl. 417. Zakona o osiguranju)
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    // Policy Expiry Reminders (Lead alerts machine)
    match /expiry_reminders/{reminderId} {
      allow read, write: if true;
    }
  }
}
