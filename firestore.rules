             )) &&
             data.status in ['open', 'new', 'quoted', 'bound', 'lost', 'in_progress', 'resolved', 'closed'] &&
             isOptionalString(data, 'assignedAgent', 0, 128) &&
             isOptionalString(data, 'notes', 0, 4000) &&
             isValidDateTime(data.createdAt) &&
             (!('updatedAt' in data) || data.updatedAt == null || isValidDateTime(data.updatedAt));
    }

    function isValidEscalationStatusTransition(prevStatus, nextStatus) {
      return prevStatus == nextStatus ||
             (prevStatus in ['open', 'new'] && nextStatus in ['in_progress', 'quoted', 'bound', 'lost', 'resolved', 'closed']) ||
             (prevStatus == 'in_progress' && nextStatus in ['resolved', 'closed']) ||
             (prevStatus == 'quoted' && nextStatus in ['new', 'bound', 'lost', 'resolved', 'closed']) ||
             (prevStatus == 'lost' && nextStatus in ['new', 'quoted']) ||
             (prevStatus == 'bound' && nextStatus in ['quoted', 'lost', 'closed']) ||
