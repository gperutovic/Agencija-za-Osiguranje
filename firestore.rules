             isValidOptionalStoredUserId(data) &&
             isNonEmptyString(data.fileName, 255) &&
             (!('fileSizeBytes' in data) || data.fileSizeBytes == null || isValidNumber(data.fileSizeBytes, 0, 52428800)) &&
             (!('parsedVia' in data) || data.parsedVia in ['gemini_ai', 'local_analyzer']) &&
             isValidExtractedPolicy(data.extractedPolicy) &&
             (!('estimatedNewAnnualPremium' in data) || data.estimatedNewAnnualPremium == null || isValidNumber(data.estimatedNewAnnualPremium, 0, 10000000)) &&
             isValidNumber(data.estimatedAnnualSavings, 0, 10000000) &&
             (!('reminderScheduledFor' in data) || data.reminderScheduledFor == null || data.reminderScheduledFor == '' || isValidDateTime(data.reminderScheduledFor)) &&
             isOptionalString(data, 'customerName', 0, 120) &&
             (!('customerEmail' in data) || data.customerEmail == null || data.customerEmail == '' || isValidEmail(data.customerEmail)) &&
             isValidOptionalPhone(data, 'customerPhone') &&
             data.status in ['new', 'quoted', 'bound', 'lost', 'reviewed', 'contacted', 'converted', 'archived'] &&
             isOptionalString(data, 'assignedAgent', 0, 128) &&
             isOptionalString(data, 'notes', 0, 4000) &&
             isValidDateTime(data.createdAt) &&
             (!('updatedAt' in data) || data.updatedAt == null || isValidDateTime(data.updatedAt));
    }

    function isValidSwitchStatusTransition(prevStatus, nextStatus) {
      return prevStatus == nextStatus ||
             (prevStatus == 'new' && nextStatus in ['quoted', 'bound', 'lost', 'reviewed', 'contacted', 'converted', 'archived']) ||
             (prevStatus == 'quoted' && nextStatus in ['new', 'bound', 'lost']) ||
             (prevStatus == 'lost' && nextStatus in ['new', 'quoted']) ||
             (prevStatus == 'bound' && nextStatus in ['quoted', 'lost']) ||
             (prevStatus == 'reviewed' && nextStatus in ['contacted', 'converted', 'archived']) ||
             (prevStatus == 'contacted' && nextStatus in ['converted', 'archived']) ||
             (prevStatus == 'archived' && nextStatus in ['reviewed', 'contacted']);
    }

    // 4. Policies (/policies/{policyId})
    function isValidOwnerEndorsementItem(item) {
      return isValidMap(item, [
               'id', 'type', 'summary', 'description', 'note', 'status', 'createdAt'
             ]) &&
             hasRequiredFields(item, ['type', 'status', 'createdAt']) &&
             isOptionalString(item, 'id', 1, 128) &&
             item.type in ['add_driver', 'change_address', 'add_coverage', 'renewal_request'] &&
             isOptionalString(item, 'summary', 1, 2000) &&
             isOptionalString(item, 'description', 1, 2000) &&
             isOptionalString(item, 'note', 1, 2000) &&
             item.status == 'requested' &&
             isValidDateTime(item.createdAt);
    }

    // Owner may prepend (agencyRepository.ts) or append exactly 1 requested endorsement
    // without modifying or deleting any existing endorsement entries.
    function isValidOwnerEndorsementUpdate() {
      let hasOld = 'endorsements' in resource.data && resource.data.endorsements is list;
      let oldList = hasOld ? resource.data.endorsements : [];
      let hasNew = 'endorsements' in request.resource.data && request.resource.data.endorsements is list;
      let newList = hasNew ? request.resource.data.endorsements : [];
      return newList.size() <= 50 && (
               newList == oldList ||
               (
                 newList.size() == oldList.size() + 1 && (
                   (newList[1:newList.size()] == oldList && isValidOwnerEndorsementItem(newList[0])) ||
                   (newList[0:oldList.size()] == oldList && isValidOwnerEndorsementItem(newList[oldList.size()]))
                 )
               )
             );
    }

    function isValidPolicy(data, policyId) {
