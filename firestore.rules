             isOptionalString(data, 'policyNumber', 0, 64) &&
             isNonEmptyString(data.subject, 200) &&
             isNonEmptyString(data.description, 5000) &&
             data.status in ['received', 'in_review', 'resolved'] &&
             (!('statutoryDeadlineDate' in data) || data.statutoryDeadlineDate == null || isValidDateTime(data.statutoryDeadlineDate)) &&
             isOptionalString(data, 'assignedAgent', 0, 128) &&
             isOptionalString(data, 'resolutionNotes', 0, 5000) &&
             (!('consents' in data) || data.consents == null || isValidClaimConsents(data.consents)) &&
             isValidDateTime(data.createdAt) &&
             (!('updatedAt' in data) || data.updatedAt == null || isValidDateTime(data.updatedAt));
    }

    function isValidComplaintStatusTransition(prevStatus, nextStatus) {
      return prevStatus == nextStatus ||
             (prevStatus == 'received' && nextStatus == 'in_review') ||
             (prevStatus == 'in_review' && nextStatus == 'resolved');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. User Profiles & Roles (contains PII — never publicly readable)
    match /users/{uid} {
      allow read: if isOwner(uid) || isAgentOrAdmin();

      // Only the signed-in owner may create their own profile, strictly with role == 'client'.
      allow create: if isOwner(uid) &&
                       uidUnchanged() &&
                       isValidUser(request.resource.data, uid) &&
                       request.resource.data.role == 'client';

      // Owner may update non-privileged profile fields only (role, uid, email, createdAt immutable).
      // Only an admin may update roles (agents cannot self-elevate to admin).
      allow update: if isValidUser(request.resource.data, uid) &&
                       uidNotModified() &&
                       areImmutableFieldsUnchanged(['uid', 'email', 'createdAt']) && (
                         (
                           isOwner(uid) &&
                           request.resource.data.role == resource.data.role &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'fullName', 'phone', 'oib', 'city', 'postalCode', 'updatedAt'
                           ])
                         ) ||
                         (
                           isAdmin() &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'role', 'fullName', 'phone', 'oib', 'city', 'postalCode', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if false;
    }

    // 2. Insurance Quote Submissions
    match /quotes/{quoteId} {
      allow read: if isAgentOrAdmin() || isRecordOwner();

      // Public intake (anonymous or signed-in) with strict schema, consent & ownership validation.
      allow create: if isValidQuote(request.resource.data, quoteId) &&
                       request.resource.data.status == 'new' &&
                       isValidCreateUserId(request.resource.data) &&
                       (!('assignedAgent' in request.resource.data) || request.resource.data.assignedAgent == null);

      // Agency ops status progression, assignment, and notes only.
      allow update: if isAgentOrAdmin() &&
                       isValidQuote(request.resource.data, quoteId) &&
                       areImmutableFieldsUnchanged(['id', 'referenceNumber', 'productLine', 'consents', 'createdAt']) &&
                       isUserIdImmutableOrLinkable() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'assignedAgent', 'notes', 'selectedOffer', 'updatedAt', 'userId'
                       ]) &&
                       isValidQuoteStatusTransition(resource.data.status, request.resource.data.status);

      allow delete: if false;
    }

    // 3. Switch & Save Policy Analyses
    match /switch_analyses/{analysisId} {
      allow read: if isAgentOrAdmin() || isRecordOwner();

      allow create: if isValidSwitchAnalysis(request.resource.data, analysisId) &&
                       request.resource.data.status == 'new' &&
                       isValidCreateUserId(request.resource.data) &&
                       (!('assignedAgent' in request.resource.data) || request.resource.data.assignedAgent == null);

      allow update: if isAgentOrAdmin() &&
                       isValidSwitchAnalysis(request.resource.data, analysisId) &&
                       areImmutableFieldsUnchanged(['id', 'referenceNumber', 'fileName', 'fileSizeBytes', 'parsedVia', 'createdAt']) &&
                       isUserIdImmutableOrLinkable() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'assignedAgent', 'notes', 'reminderScheduledFor',
                         'extractedPolicy', 'estimatedNewAnnualPremium', 'estimatedAnnualSavings',
                         'updatedAt', 'userId'
                       ]) &&
                       isValidSwitchStatusTransition(resource.data.status, request.resource.data.status);

      allow delete: if false;
    }

    // 4. Active & Historical Policies
    match /policies/{policyId} {
      allow read: if isAgentOrAdmin() || isRecordOwner();

      allow create: if isAgentOrAdmin() &&
                       isValidPolicy(request.resource.data, policyId);

      // Agent/admin may update validated policy fields.
      // Policy owner may ONLY request renewal (status -> 'pending_renewal') or prepend/append a requested
      // endorsement without altering financial, carrier, or ownership fields.
      allow update: if isValidPolicy(request.resource.data, policyId) && (
                         isAgentOrAdmin() ||
                         (
                           isRecordOwner() &&
                           areImmutableFieldsUnchanged([
                             'id', 'policyNumber', 'userId', 'clientName', 'clientOib',
                             'productLine', 'carrierName', 'startDate', 'expiryDate',
                             'annualPremium', 'monthlyPremium', 'deductible', 'coverageLimit',
                             'assetSummary', 'vehiclePlate', 'propertyAddress', 'greenCardNumber',
                             'ipidCode', 'renewalReminderSentAt', 'createdAt'
                           ]) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'endorsements', 'status', 'updatedAt'
                           ]) &&
                           (
                             request.resource.data.status == resource.data.status ||
                             (
                               resource.data.status in ['active', 'expiring_soon'] &&
                               request.resource.data.status == 'pending_renewal'
                             )
                           ) &&
                           isValidOwnerEndorsementUpdate()
                         )
                       );

      allow delete: if isAgentOrAdmin();
    }

    // 5. Digital FNOL Claims
    match /claims/{claimId} {
      allow read: if isAgentOrAdmin() || isRecordOwner();

      // Public FNOL intake (anonymous or signed-in) with strict schema & GDPR consent validation.
      allow create: if isValidClaim(request.resource.data, claimId) &&
                       request.resource.data.stage == 'received' &&
                       isValidCreateUserId(request.resource.data) &&
                       (!('attachments' in request.resource.data) || areInitialAttachmentsValid(request.resource.data.attachments));

      // Agent/admin progresses triage stage, stageHistory, estimatedAmount & updatedAt.
      // Signed-in owner may ONLY append new attachments and update updatedAt without altering stage.
      allow update: if isValidClaim(request.resource.data, claimId) &&
                       areImmutableFieldsUnchanged([
                         'id', 'referenceNumber', 'userId', 'policyNumber', 'productLine',
                         'carrierName', 'claimantName', 'claimantOib', 'claimantEmail',
                         'claimantPhone', 'incidentDate', 'incidentTime', 'incidentLocation',
                         'description', 'policeReportFiled', 'consents', 'createdAt'
                       ]) && (
                         (
                           isAgentOrAdmin() &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'stage', 'stageHistory', 'estimatedAmount', 'updatedAt'
                           ]) &&
                           isValidClaimStageTransition(resource.data.stage, request.resource.data.stage) &&
                           isValidStageHistoryUpdate()
                         ) ||
                         (
                           isRecordOwner() &&
                           request.resource.data.stage == resource.data.stage &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'attachments', 'updatedAt'
                           ]) &&
                           isValidOwnerAttachmentAppend()
                         )
                       );

      allow delete: if false;
    }

    // 6. AI Advisor Human Escalations
    match /escalations/{escalationId} {
      allow read: if isAgentOrAdmin() || isRecordOwner();

      // Accepts 'open' (spec) or 'new' (domain.ts QuotePipelineStatus) on public intake.
      allow create: if isValidEscalation(request.resource.data, escalationId) &&
                       request.resource.data.status in ['open', 'new'] &&
                       isValidCreateUserId(request.resource.data) &&
                       (!('assignedAgent' in request.resource.data) || request.resource.data.assignedAgent == null);

      allow update: if isAgentOrAdmin() &&
                       isValidEscalation(request.resource.data, escalationId) &&
                       areImmutableFieldsUnchanged([
                         'id', 'referenceNumber', 'customerEmail', 'topic', 'transcript', 'createdAt'
                       ]) &&
                       isUserIdImmutableOrLinkable() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'assignedAgent', 'notes', 'updatedAt', 'userId'
                       ]) &&
                       isValidEscalationStatusTransition(resource.data.status, request.resource.data.status);

      allow delete: if false;
    }

    // 7. Client-Advisor Message Center (Immutable Audit Trail)
    match /messages/{messageId} {
      allow read: if isAgentOrAdmin() ||
                     (isSignedIn() && resource.data.threadUserId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidMessage(request.resource.data, messageId) && (
                         (
                           request.resource.data.threadUserId == request.auth.uid &&
                           request.resource.data.senderRole == 'client'
                         ) ||
                         (
                           isAgentOrAdmin() &&
                           request.resource.data.senderRole == 'agent'
                         )
                       );

      allow update, delete: if false;
    }

    // 8. Statutory Complaints Register (Art. 401 Croatian Insurance Act)
    match /complaints/{complaintId} {
      allow read: if isAgentOrAdmin();

      allow create: if isValidComplaint(request.resource.data, complaintId) &&
                       request.resource.data.status == 'received' &&
                       (!('assignedAgent' in request.resource.data) || request.resource.data.assignedAgent == null) &&
                       (!('resolutionNotes' in request.resource.data) || request.resource.data.resolutionNotes == null);

      allow update: if isAgentOrAdmin() &&
                       isValidComplaint(request.resource.data, complaintId) &&
                       areImmutableFieldsUnchanged([
                         'id', 'protocolNumber', 'fullName', 'oib', 'email', 'phone',
                         'address', 'policyNumber', 'subject', 'description',
                         'statutoryDeadlineDate', 'consents', 'createdAt'
                       ]) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'assignedAgent', 'resolutionNotes', 'updatedAt'
                       ]) &&
                       isValidComplaintStatusTransition(resource.data.status, request.resource.data.status);

      allow delete: if false;
    }

    // 9. Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
