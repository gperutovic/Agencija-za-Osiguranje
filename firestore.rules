rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Accounts & Licensed Advisor Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Comparative Quotes & Leads
    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    // Policies In-Force & Bound Contracts
    match /policies/{policyId} {
      allow read, write: if true;
    }

    // FNOL First Notice of Loss Claims
    match /claims/{claimId} {
      allow read, write: if true;
    }

    // Policy Endorsement & Change Requests
    match /endorsements/{endorsementId} {
      allow read, write: if true;
    }

    // Advisor Consultations & Callback Requests
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Digital Insurance Certificates & Cards
    match /digital_cards/{cardId} {
      allow read, write: if true;
    }

    // Contact Inquiries & Feedback
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Leads from Interactive Calculators & Guided Intake
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // IDD Demands and Needs Assessments
    match /needs_assessments/{assessmentId} {
      allow read, write: if true;
    }

    // Official Complaints Register (čl. 401. Zakona o osiguranju)
    match /complaints/{complaintId} {
      allow read, write: if true;
    }
  }
}
