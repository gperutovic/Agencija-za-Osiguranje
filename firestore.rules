             isOptionalString(data, 'incidentTime', 0, 20) &&
             isOptionalString(data, 'incidentLocation', 0, 250) &&
             isNonEmptyString(data.description, 4000) &&
             (!('policeReportFiled' in data) || data.policeReportFiled is bool) &&
             (!('attachments' in data) || isValidList(data.attachments, 20)) &&
