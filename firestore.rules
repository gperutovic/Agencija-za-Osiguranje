             (!('includeDiagnostics' in inp) || inp.includeDiagnostics is bool) &&
             (!('familyMembers' in inp) || isValidNumber(inp.familyMembers, 1, 20));
    }

    function isValidLifeQuoteInput(inp) {
      return isValidMap(inp, [
               'productLine', 'age', 'smoker', 'sumInsured', 'termYears', 'includeCriticalIllness'
             ]) &&
             inp.productLine == 'zivotno' &&
             (!('age' in inp) || isValidNumber(inp.age, 18, 85)) &&
             (!('smoker' in inp) || inp.smoker is bool) &&
             (!('sumInsured' in inp) || isValidNumber(inp.sumInsured, 1000, 10000000)) &&
             (!('termYears' in inp) || isValidNumber(inp.termYears, 1, 50)) &&
             (!('includeCriticalIllness' in inp) || inp.includeCriticalIllness is bool);
    }

    function isValidTravelQuoteInput(inp) {
      return isValidMap(inp, [
               'productLine', 'destination', 'days', 'travelers', 'includeWinterSports', 'includeCancellation'
             ]) &&
             inp.productLine == 'putno' &&
             (!('destination' in inp) || inp.destination in ['eu', 'world_excl_us', 'world_incl_us']) &&
             (!('days' in inp) || isValidNumber(inp.days, 1, 365)) &&
             (!('travelers' in inp) || isValidNumber(inp.travelers, 1, 50)) &&
             (!('includeWinterSports' in inp) || inp.includeWinterSports is bool) &&
             (!('includeCancellation' in inp) || inp.includeCancellation is bool);
    }

    function isValidPetQuoteInput(inp) {
      return isValidMap(inp, [
               'productLine', 'petType', 'petAgeYears', 'breedSize', 'includeLiability'
             ]) &&
             inp.productLine == 'ljubimci' &&
             (!('petType' in inp) || inp.petType in ['dog', 'cat']) &&
             (!('petAgeYears' in inp) || isValidNumber(inp.petAgeYears, 0, 30)) &&
             (!('breedSize' in inp) || inp.breedSize in ['small', 'medium', 'large']) &&
             (!('includeLiability' in inp) || inp.includeLiability is bool);
    }

    function isValidBusinessQuoteInput(inp) {
      return isValidMap(inp, [
               'productLine', 'companyType', 'employees', 'annualRevenueBand',
               'includeProfessionalLiability', 'includeCyber'
             ]) &&
             inp.productLine == 'poslovno' &&
             (!('companyType' in inp) || inp.companyType in ['obrt', 'doo', 'slobodna_djelatnost']) &&
             (!('employees' in inp) || isValidNumber(inp.employees, 1, 100000)) &&
             (!('annualRevenueBand' in inp) || inp.annualRevenueBand in ['under_100k', '100k_500k', 'over_500k']) &&
             (!('includeProfessionalLiability' in inp) || inp.includeProfessionalLiability is bool) &&
             (!('includeCyber' in inp) || inp.includeCyber is bool);
    }

    function isValidQuoteInputs(inp, productLine) {
      return inp is map &&
             'productLine' in inp &&
             inp.productLine == productLine && (
               (productLine == 'auto' && isValidAutoQuoteInput(inp)) ||
               (productLine == 'imovina' && isValidPropertyQuoteInput(inp)) ||
               (productLine == 'zdravstveno' && isValidHealthQuoteInput(inp)) ||
               (productLine == 'zivotno' && isValidLifeQuoteInput(inp)) ||
               (productLine == 'putno' && isValidTravelQuoteInput(inp)) ||
               (productLine == 'ljubimci' && isValidPetQuoteInput(inp)) ||
               (productLine == 'poslovno' && isValidBusinessQuoteInput(inp))
             );
    }

    function isValidQuote(data, quoteId) {
      return hasOnlyAllowedFields(data, [
               'id', 'referenceNumber', 'userId', 'productLine', 'bundleProducts',
               'inputs', 'customization', 'selectedOffer', 'customer', 'consents',
               'status', 'assignedAgent', 'source', 'notes', 'createdAt', 'updatedAt'
             ]) &&
             hasRequiredFields(data, [
               'referenceNumber', 'productLine', 'customer', 'consents', 'status', 'createdAt'
             ]) &&
             (!('id' in data) || (data.id is string && data.id == quoteId && data.id.size() <= 128)) &&
             isNonEmptyString(data.referenceNumber, 64) &&
             isValidOptionalStoredUserId(data) &&
             isValidProductLine(data.productLine) &&
             (!('bundleProducts' in data) || (
               isValidList(data.bundleProducts, 7) &&
               data.bundleProducts.hasOnly(['auto', 'imovina', 'zdravstveno', 'zivotno', 'putno', 'ljubimci', 'poslovno'])
             )) &&
             (!('inputs' in data) || data.inputs == null || isValidQuoteInputs(data.inputs, data.productLine)) &&
             (!('customization' in data) || data.customization == null || isValidCoverageCustomization(data.customization)) &&
