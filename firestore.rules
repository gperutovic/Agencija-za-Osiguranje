    function isValidStageHistoryUpdate() {
      let hasOld = 'stageHistory' in resource.data && resource.data.stageHistory is list;
      let oldList = hasOld ? resource.data.stageHistory : [];
      let hasNew = 'stageHistory' in request.resource.data && request.resource.data.stageHistory is list;
      let newList = hasNew ? request.resource.data.stageHistory : [];
      return !('stageHistory' in request.resource.data) || (
               hasNew &&
               newList.size() <= 30 &&
