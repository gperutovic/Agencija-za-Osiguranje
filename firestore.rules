    // 6. AI Escalations (/escalations/{escalationId})
    function isValidAdvisorChatCard(card) {
      return isValidMap(card, ['type', 'title', 'subtitle', 'productLine', 'bullets', 'priceHint']) &&
             hasRequiredFields(card, ['type', 'title', 'subtitle']) &&
             card.type in ['coverage_comparison', 'quote_cta'] &&
