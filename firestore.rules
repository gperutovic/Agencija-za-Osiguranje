             isValidDateTime(data.createdAt) &&
             (!('updatedAt' in data) || data.updatedAt == null || isValidDateTime(data.updatedAt));
    }

    function isValidQuoteStatusTransition(prevStatus, nextStatus) {
      return prevStatus == nextStatus ||
             (prevStatus == 'new' && nextStatus in ['quoted', 'bound', 'lost']) ||
             (prevStatus == 'quoted' && nextStatus in ['new', 'bound', 'lost']) ||
             (prevStatus == 'lost' && nextStatus in ['new', 'quoted']) ||
             (prevStatus == 'bound' && nextStatus in ['quoted', 'lost']);
    }

    // 3. Switch & Save Analyses (/switch_analyses/{analysisId})
    function isValidExtractedPolicy(ep) {
      return isValidMap(ep, [
               'insurer', 'productLine', 'policyNumber', 'expiryDate',
               'currentAnnualPremium', 'bonusPercent', 'deductible'
             ]) &&
             hasRequiredFields(ep, ['insurer', 'productLine', 'expiryDate', 'currentAnnualPremium']) &&
