rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isBrokerOrAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['broker', 'admin']
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isBrokerOrAdmin();
    }
    match /quotes/{quoteId} {
      allow create, read: if true; // Public prospects and client quote comparisons
      allow update, delete: if isBrokerOrAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    match /policies/{policyId} {
      allow read: if true;
      allow write: if isBrokerOrAdmin();
    }
    match /claims/{claimId} {
      allow create, read: if true; // Instant FNOL claim filing and lookup
      allow update, delete: if isBrokerOrAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    match /appointments/{appointmentId} {
      allow create, read: if true; // Certified broker consultation scheduling
      allow update, delete: if isBrokerOrAdmin();
    }
    match /digital_cards/{cardId} {
      allow create, read: if true; // Cryptographic verification for police & technical checks
      allow update, delete: if isBrokerOrAdmin();
    }
  }
}

