             (!('size' in att) || isValidNumber(att.size, 0, 26214400)) &&
             (!('previewDataUrl' in att) || att.previewDataUrl == null || isValidImageDataUrl(att.previewDataUrl)) &&
             (!('storageUrl' in att) || att.storageUrl == null || isValidUrl(att.storageUrl)) &&
             (!('url' in att) || att.url == null || isValidUrl(att.url)) &&
             (!('storagePath' in att) || att.storagePath == null || isValidStoragePath(att.storagePath)) &&
             (!('uploadedAt' in att) || isValidDateTime(att.uploadedAt));
    }

    function areInitialAttachmentsValid(attList) {
      let n = attList.size();
      return n <= 10 &&
             (n < 1 || isValidAttachmentItem(attList[0])) &&
             (n < 2 || isValidAttachmentItem(attList[1])) &&
             (n < 3 || isValidAttachmentItem(attList[2])) &&
             (n < 4 || isValidAttachmentItem(attList[3])) &&
             (n < 5 || isValidAttachmentItem(attList[4])) &&
             (n < 6 || isValidAttachmentItem(attList[5])) &&
             (n < 7 || isValidAttachmentItem(attList[6])) &&
             (n < 8 || isValidAttachmentItem(attList[7])) &&
             (n < 9 || isValidAttachmentItem(attList[8])) &&
             (n < 10 || isValidAttachmentItem(attList[9]));
    }

    function isValidOwnerAttachmentAppend() {
      let hasOld = 'attachments' in resource.data && resource.data.attachments is list;
      let oldList = hasOld ? resource.data.attachments : [];
      let hasNew = 'attachments' in request.resource.data && request.resource.data.attachments is list;
      let newList = hasNew ? request.resource.data.attachments : [];
      let added = newList.size() - oldList.size();
      return hasNew &&
             newList.size() <= 20 &&
             added >= 1 && added <= 5 &&
             newList[0:oldList.size()] == oldList &&
             isValidAttachmentItem(newList[oldList.size()]) &&
             (added < 2 || isValidAttachmentItem(newList[oldList.size() + 1])) &&
             (added < 3 || isValidAttachmentItem(newList[oldList.size() + 2])) &&
             (added < 4 || isValidAttachmentItem(newList[oldList.size() + 3])) &&
             (added < 5 || isValidAttachmentItem(newList[oldList.size() + 4]));
    }

    function isValidStageHistoryEntry(entry) {
      return isValidMap(entry, ['stage', 'note', 'timestamp', 'actor', 'updatedBy']) &&
             hasRequiredFields(entry, ['stage', 'timestamp']) &&
             entry.stage in ['received', 'insurer_review', 'assessment', 'paid'] &&
             isOptionalString(entry, 'note', 0, 1000) &&
             isValidDateTime(entry.timestamp) &&
             isOptionalString(entry, 'actor', 0, 128) &&
             isOptionalString(entry, 'updatedBy', 0, 128);
